# Get this from Framer: Site Settings -> General -> Server API
FRAMER_API_KEY=fr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The project URL from your Framer browser tab, e.g.
# https://framer.com/projects/Sites--aabbccddeeff or the site URL
FRAMER_PROJECT_URL=https://framer.com/projects/Sites--your-project-id

# Optional: simple shared-secret auth for the endpoints below,
# so n8n (and only n8n) can call this service
SERVICE_API_KEY=choose-a-long-random-string

PORT=3000
