      "id": "d1d1d1d1-0003-4000-8000-000000000003",
      "name": "Get Current Drills",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        0
      ],
      "executeOnce": true
