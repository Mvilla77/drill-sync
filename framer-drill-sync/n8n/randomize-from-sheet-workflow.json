    {
      "parameters": {
        "jsCode": "// Read the drills database (Google Sheets) and the drill cards currently\n// live on the site, and pair each site card with a random matching drill\n// from the sheet (same program + block), without repeating within a group\n// as long as the sheet has enough entries for that group.\n\nconst sheetRows = $('Google Sheets').all().map(item => item.json);\nconst currentSlots = $('Get Current Drills').first().json.drills;\n\nfunction shuffle(arr) {\n  const a = [...arr];\n  for (let i = a.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [a[i], a[j]] = [a[j], a[i]];\n  }\n  return a;\n}\n\nconst buckets = {};\nfor (const row of sheetRows) {\n  const key = `${row.program}::${row.block}`;\n  if (!buckets[key]) buckets[key] = [];\n  buckets[key].push(row);\n}\nconst shuffledBuckets = {};\nfor (const key in buckets) shuffledBuckets[key] = shuffle(buckets[key]);\nconst cursors = {};\n\nconst updates = [];\nfor (const slot of currentSlots) {\n  const key = `${slot.program}::${slot.block}`;\n  const bucket = shuffledBuckets[key];\n  if (!bucket || bucket.length === 0) continue; // no matching drills in the sheet for this group\n\n  const cursor = cursors[key] || 0;\n  const pick = bucket[cursor % bucket.length];\n  cursors[key] = cursor + 1;\n\n  updates.push({\n    program: slot.program,\n    day: slot.day,\n    block: slot.block,\n    currentExercise: slot.exercise,\n    exercise: pick.exercise,\n    duration: pick.duration,\n    coachNotes: pick.coachNotes,\n    purpose: pick.purpose\n  });\n}\n\nreturn [{ json: { updates } }];"
      },
